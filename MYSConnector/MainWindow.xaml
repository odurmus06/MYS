<Window x:Class="MYSConnector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Height="768" Width="1280"
        MinHeight="650" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeBgDeep}">

    <Window.Resources>
        <Style x:Key="SidebarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Margin="4,2">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                  VerticalAlignment="Center" Margin="12,0"/>
                            </Border>
                            <Border x:Name="activeMarker" Width="3" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Height="24" CornerRadius="2"
                                    Background="{DynamicResource ThemeAccentPrimaryBrush}"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeBgItemHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeBgItemSelectedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccentPrimaryBrush}"/>
                                <Setter TargetName="activeMarker" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- LAYER 1: Main App Content -->
        <Grid x:Name="AppContent" IsEnabled="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource ThemeBgPanel}" 
                    BorderBrush="{DynamicResource ThemeBorderGlassBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Text logo -->
                    <TextBlock Grid.Row="0" Text="HvBS" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource ThemeAccentPrimaryBrush}"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               Margin="8,12,0,20"/>

                    <TextBlock Grid.Row="1" Text="MESSAGES" Foreground="{DynamicResource ThemeTextMutedBrush}" 
                               FontSize="10" FontWeight="Bold" Margin="12,0,0,8" Opacity="0.7"/>

                    <StackPanel Grid.Row="2">
                        <Button x:Name="NavAtoButton" Style="{StaticResource SidebarBtn}" Click="NavAto_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="16" Height="16" Margin="0,0,10,0" Stretch="Uniform"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}}, Path=Foreground}"
                                      StrokeThickness="1.5"
                                      Data="M4,2 L12,2 L12,4 L15,4 L15,15 L1,15 L1,4 L4,4 Z M5,1 L11,1 L11,3 L5,3 Z M3,7 L13,7 M3,10 L13,10 M3,13 L9,13"/>
                                <TextBlock Text="ATO Messages" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavAcoButton" Style="{StaticResource SidebarBtn}" Click="NavAco_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="16" Height="16" Margin="0,0,10,0" Stretch="Uniform"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}}, Path=Foreground}"
                                      StrokeThickness="1.5"
                                      Data="M8,1 L10,7 L16,9 L16,11 L10,10 L10,15 L13,17 L13,18 L8,16 L3,18 L3,17 L6,15 L6,10 L0,11 L0,9 L6,7 Z"/>
                                <TextBlock Text="ACO Messages" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Settings at bottom -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,8">
                        <Border Height="1" Background="{DynamicResource ThemeBorderGlassBrush}" Margin="4,0,4,8" Opacity="0.5"/>
                        <Button x:Name="NavSettingsButton" Style="{StaticResource SidebarBtn}" Click="NavSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="16" Height="16" Margin="0,0,10,0" Stretch="Uniform"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}}, Path=Foreground}"
                                      StrokeThickness="1.5"
                                      Data="M2,4 L14,4 M2,8 L14,8 M2,12 L14,12 M5,2 L5,6 M10,6 L10,10 M7,10 L7,14"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right Content Area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <!-- Top Bar: Page + Logout -->
                <Border Grid.Row="0" Background="{DynamicResource ThemeBgCard}"
                        BorderBrush="{DynamicResource ThemeBorderGlassBrush}" BorderThickness="0,0,0,1" Padding="20,10">
                    <Grid>
                        <TextBlock x:Name="PageTitle" Text="ATO — Air Tasking Order" 
                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}" 
                                   FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="LogoutButton" Cursor="Hand" Click="Logout_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="5" Padding="12,6" Cursor="Hand"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource ThemeAccentRedBrush}" BorderThickness="1">
                                            <TextBlock x:Name="LogoutText" Text="Logout" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ThemeAccentRedBrush}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeAccentRedBrush}"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentRedBrush}"/>
                                                <Setter TargetName="LogoutText" Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ContentControl x:Name="MainContentFrame" Grid.Row="1"/>

                <!-- Bottom status panel -->
                <Border Grid.Row="2" Background="{DynamicResource ThemeBgStatusBar}"
                        BorderBrush="{DynamicResource ThemeBorderGlassBrush}" BorderThickness="0,1,0,0"
                        Padding="12,0">
                    <Grid>
                        <TextBlock x:Name="BottomServiceStatusText" Text="SERVICE STATUS: READY"
                                   Foreground="{DynamicResource ThemeAccentGreenBrush}" FontSize="10"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BottomContextText" Text="ATO MESSAGES"
                                   Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="BottomOperationText" Text="Ready"
                                       Foreground="{DynamicResource ThemeTextMutedBrush}" FontSize="10"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock Text="MYSClient v1.0" Foreground="{DynamicResource ThemeTextFooterBrush}"
                                       FontSize="9" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- LAYER 2: Login Overlay -->
        <Grid x:Name="LoginOverlay" Visibility="Visible">
            <Rectangle Fill="#CC000000"/>

            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="400"
                    CornerRadius="16" Padding="40,35">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource ThemeBgCardColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource ThemeBgPanelColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="50" ShadowDepth="0" Opacity="0.5" 
                                      Color="{DynamicResource ThemeAccentPrimary}"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="HvBS" FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,4"
                               Foreground="{DynamicResource ThemeAccentPrimaryBrush}"/>
                    <TextBlock Text="ATO / ACO Message System" FontSize="11" HorizontalAlignment="Center" 
                               Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,0,0,28"/>

                    <TextBlock Text="USERNAME" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"
                               Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                    <Border Background="{DynamicResource ThemeBgInput}" CornerRadius="8" 
                            BorderBrush="{DynamicResource ThemeBorderGlassBrush}" BorderThickness="1" Margin="0,0,0,16">
                        <TextBox x:Name="LoginUsername" KeyDown="LoginField_KeyDown" Background="Transparent" BorderThickness="0" 
                                 Foreground="{DynamicResource ThemeTextPrimaryBrush}" Padding="12,10" FontSize="13"
                                 CaretBrush="{DynamicResource ThemeAccentPrimaryBrush}"/>
                    </Border>

                    <TextBlock Text="PASSWORD" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"
                               Foreground="{DynamicResource ThemeTextMutedBrush}"/>
                    <Border Background="{DynamicResource ThemeBgInput}" CornerRadius="8" 
                            BorderBrush="{DynamicResource ThemeBorderGlassBrush}" BorderThickness="1" Margin="0,0,0,24">
                        <PasswordBox x:Name="LoginPassword" KeyDown="LoginField_KeyDown" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource ThemeTextPrimaryBrush}" Padding="12,10" FontSize="13"
                                     CaretBrush="{DynamicResource ThemeAccentPrimaryBrush}"/>
                    </Border>

                    <Button x:Name="LoginButton" Height="44" IsDefault="True" Cursor="Hand" Click="LoginButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="8" Cursor="Hand">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="{DynamicResource ThemeAccentPrimary}" Offset="0"/>
                                            <GradientStop Color="{DynamicResource ThemeAccentSecondary}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="SIGN IN" FontSize="15" FontWeight="Bold" 
                                               Foreground="{DynamicResource ThemeBgDeep}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock x:Name="LoginError" Text="" FontSize="12" HorizontalAlignment="Center" 
                               Margin="0,14,0,0" Foreground="{DynamicResource ThemeAccentRedBrush}"
                               Visibility="Collapsed"/>

                    <TextBlock Text="v1.0 — NATO STANAG Compatible" FontSize="9" HorizontalAlignment="Center" 
                               Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,20,0,0" Opacity="0.5"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
