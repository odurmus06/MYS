<UserControl x:Class="MYSConnector.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    
    <Grid Background="{DynamicResource ThemeBgDeep}">
        <Border MaxWidth="600" VerticalAlignment="Top" Margin="40,40" 
                Background="{DynamicResource ThemeBgCard}" CornerRadius="12" Padding="32,28"
                BorderBrush="{DynamicResource ThemeBorderGlassBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.15" Color="#000000"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="SETTINGS" FontSize="20" FontWeight="Bold" 
                           Foreground="{DynamicResource ThemeAccentPrimaryBrush}" Margin="0,0,0,28"/>

                <!-- Output Folder -->
                <TextBlock Text="PARSED FILE OUTPUT FOLDER" FontSize="10" FontWeight="Bold" 
                           Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,0,0,8"/>
                <TextBlock Text="Parsed messages will be saved to this folder. Select a folder before using the Parse feature." 
                           FontSize="11" Foreground="{DynamicResource ThemeTextMutedBrush}" 
                           TextWrapping="Wrap" Margin="0,0,0,12" Opacity="0.7"/>
                
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Background="{DynamicResource ThemeBgInput}" CornerRadius="6"
                            BorderBrush="{DynamicResource ThemeBorderGlassBrush}" BorderThickness="1" Padding="10,8"
                            Margin="0,0,8,0">
                        <TextBlock x:Name="FolderPathText" Text="No folder selected..." 
                                   Foreground="{DynamicResource ThemeTextMutedBrush}" 
                                   FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    
                    <Button Grid.Column="1" Cursor="Hand" Click="BrowseFolder_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="6" Padding="16,8" Cursor="Hand">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="{DynamicResource ThemeAccentPrimary}" Offset="0"/>
                                            <GradientStop Color="{DynamicResource ThemeAccentSecondary}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="Browse" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ThemeBgDeep}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Service request policy -->
                <TextBlock Text="SERVICE REQUEST POLICY" FontSize="10" FontWeight="Bold"
                           Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,16,0,8"/>
                <TextBlock Text="These values control generated web-service calls. Timeout: 5–300 seconds; retries: 0–5. Changes apply to the next request."
                           FontSize="11" Foreground="{DynamicResource ThemeTextMutedBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,12" Opacity="0.7"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="TIMEOUT (SECONDS)" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,0,0,5"/>
                        <TextBox x:Name="TimeoutTextBox" Height="32" Padding="10,7"
                                 Background="{DynamicResource ThemeBgInput}"
                                 BorderBrush="{DynamicResource ThemeBorderGlassBrush}" BorderThickness="1"
                                 Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                        <TextBlock Text="MAX RETRIES" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,0,0,5"/>
                        <TextBox x:Name="RetriesTextBox" Height="32" Padding="10,7"
                                 Background="{DynamicResource ThemeBgInput}"
                                 BorderBrush="{DynamicResource ThemeBorderGlassBrush}" BorderThickness="1"
                                 Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="2" VerticalAlignment="Bottom" Height="32" Cursor="Hand"
                            Click="SaveServicePolicy_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="6" Padding="14,6" Cursor="Hand"
                                        Background="{DynamicResource ThemeBgInput}"
                                        BorderBrush="{DynamicResource ThemeBorderGlassBrush}" BorderThickness="1">
                                    <TextBlock Text="SAVE" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeBgItemHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Status -->
                <Border x:Name="StatusBorder" Visibility="Collapsed" Background="{DynamicResource ThemeBgInput}" 
                        CornerRadius="6" Padding="12,10" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="OK" Foreground="{DynamicResource ThemeAccentGreenBrush}" FontSize="11" FontWeight="Bold" 
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Text="" Foreground="{DynamicResource ThemeAccentGreenBrush}" 
                                   FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <Border Height="1" Background="{DynamicResource ThemeBorderGlassBrush}" Margin="0,24,0,24"/>

                <!-- App Info -->
                <TextBlock Text="APPLICATION INFO" FontSize="10" FontWeight="Bold" 
                           Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Application" FontSize="11" 
                               Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="MYS Connector v1.0" FontSize="11" 
                               Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="0,0,0,6"/>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Standard" FontSize="11" 
                               Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="NATO STANAG ATO/ACO" FontSize="11" 
                               Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="0,0,0,6"/>
                    
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Framework" FontSize="11" 
                               Foreground="{DynamicResource ThemeTextMutedBrush}" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text=".NET Framework 4.5 / WPF" FontSize="11" 
                               Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="0,0,0,6"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
